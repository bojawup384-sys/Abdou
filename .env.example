# Neon (Postgres) — من لوحة Neon: Connection string (يفضّل الـ pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini — من https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اختياري (الافتراضي gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# اختياري: عند فشل Gemini استخدم المحرك المحلي بدل إظهار خطأ (الافتراضي: معطّل)
# ALLOW_LOCAL_FALLBACK=true

# Firebase — القيم الافتراضية مضمّنة في الكود، ضعها فقط لتجاوزها
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mohtal-9b1d3
